<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Clast.BloomFilter" />
    <!-- Named by StructuralRowHash: Decimal128 is the one cell type whose own GetHashCode is
         seeded per process, and the row hash has to be deterministic. Naming it here costs one
         package reference and removes a registration hook from the hottest path in the engine. -->
    <PackageReference Include="Clast.DatabaseDecimal" />
  </ItemGroup>
  <ItemGroup>
    <!-- DbspNet.Sql implements its own IOperator for the recursive-CTE
         batch-fixed-point runtime; that operator is a SQL-layer concern but
         needs to register itself with the Core circuit via the internal
         AddRawOperator surface. -->
    <InternalsVisibleTo Include="DbspNet.Sql" />
    <InternalsVisibleTo Include="DbspNet.Tests" />
    <!-- Persistence enumerates RootCircuit.Operators for snapshot
         orchestration; the IOperator/Operators surface is internal. -->
    <InternalsVisibleTo Include="DbspNet.Persistence" />
    <!-- Benchmarks compare internal ZSetTrace / IndexedZSetTrace against
         the public Spine variants. -->
    <InternalsVisibleTo Include="DbspNet.Benchmarks" />
  </ItemGroup>
</Project>
